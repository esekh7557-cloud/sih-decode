# OpenRouter API key for optional LLM eligibility enrichment.
# The rule-based engine works fully without it. NEVER commit a real key.
# Never commit a real API key.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Document extraction mode: ai (normal), mock (always synthetic data), or
# fallback (try AI, then use synthetic data if OpenRouter is unavailable).
JANSEVA_EXTRACTION_MODE=ai
# Form filler data mode: session (normal) or dummy (local Selenium testing).
JANSEVA_FORM_FILLER_MODE=session
# Optional Edge profile directory for local Selenium testing.
JANSEVA_BROWSER_PROFILE_DIR=.janseva-browser/edge-debug-profile

# Live official-web guidance. Keep this key in .env only, never commit it.


JANSEVA_DEMO_MODE=1
KIOSK_LOCATION=Mamlatdar Office
KIOSK_TALUKA=
KIOSK_DISTRICT=
KIOSK_STATE=Maharashtra
