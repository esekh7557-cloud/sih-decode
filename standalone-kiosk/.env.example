# OpenRouter API key for optional LLM eligibility enrichment.
# The rule-based engine works fully without it. NEVER commit a real key.
OPENROUTER_API_KEY=sk-or-v1-PASTE_YOUR_KEY_HERE
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# 1 = run with mock scanner/printer so the kiosk works end-to-end without hardware
JANSEVA_DEMO_MODE=1

KIOSK_LOCATION=Mamlatdar Office
KIOSK_TALUKA=
KIOSK_DISTRICT=
KIOSK_STATE=Maharashtra

# OpenRouter API Key (Required for Computer Use Agent)
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="openrouter/free"
